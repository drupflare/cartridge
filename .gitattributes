# keep the npm tarball to what a consumer installs. `files` in package.json is the
# primary control for npm; these rules cover `git archive` and a GitHub source tarball,
# which is what a git dependency or a release asset serves.
# the directories are listed twice on purpose: git archive prunes a directory marked
# export-ignore, but `git check-attr` on a file inside it reports "unspecified", so the
# /** form is what makes the exclusion verifiable per file rather than only documented
/.github export-ignore
/.github/** export-ignore
/.husky export-ignore
/.husky/** export-ignore
/.vscode export-ignore
/.vscode/** export-ignore
/tests export-ignore
/tests/** export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.markdownlint.json export-ignore
/.prettierignore export-ignore
/.prettierrc export-ignore
/bun.lock export-ignore
/codecov.yml export-ignore
/renovate.json export-ignore
/tsconfig.json export-ignore
/vitest.config.ts export-ignore
/wrangler.jsonc export-ignore
/CLAUDE.md export-ignore
