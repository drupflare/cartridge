{
	"plugins": [
		"prettier-plugin-organize-imports",
		"@prettier/plugin-php",
		"@prettier/plugin-xml",
		"prettier-plugin-sh"
	],
	"printWidth": 100,
	"singleQuote": true,
	"semi": true,
	"useTabs": true,
	"singleAttributePerLine": true,
	"trailingComma": "none",
	"endOfLine": "lf",
	"overrides": [
		{
			"files": "*.{php,module,install,inc,theme,profile,engine}",
			"options": {
				"parser": "php"
			}
		},
		{
			"files": "*.jsonc",
			"options": {
				"parser": "json"
			}
		},
		{
			"files": "*.xml.dist",
			"options": {
				"parser": "xml",
				"singleAttributePerLine": false,
				"xmlWhitespaceSensitivity": "ignore",
				"bracketSameLine": true
			}
		},
		{
			"files": "*.md",
			"options": {
				"useTabs": false,
				"tabWidth": 2
			}
		}
	]
}
